; Startup paths are one explicit input to this Flow process. Refusal carries
; the path and reason without turning a foreign or older store into an empty
; database.
Library
[]
[ OrdinarySocketPath.String
  MetaSocketPath.String
  StorePath.String
  Start.{ OrdinarySocketPath MetaSocketPath StorePath }
  Path.String
  Reason.String
  StoreRefusal.{ Path Reason }
  StartRefusal.[ Store.StoreRefusal ]
  ; Whether this Flow opens the store at a path, judged on a copy so the
  ; store a running Nexus holds is never touched: a deploy runs it before
  ; it activates this Flow.
  StoreCheckRequest.{ StorePath }
  StoreCheck.[ Opens.StorePath Absent.StorePath Refused.StoreRefusal ] ]
[ ChecksStore.[ check.[ StoreCheck ] ] ]
[]
