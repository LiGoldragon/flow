; Flow's shared types live in this leaf package. Signal and Meta-Signal
; import them here and re-export their original Rust paths. Aspect is one
; nominal type shared by addresses, launch profiles and meta configuration.

Library
[ :crate:generated:delivery:[ Delivery Message ] ]
[ FlowId.String
  ; ethos-zero 16 cannot express Topic:Name yet; check camelCase at input.
  Topic.String
  ; The design type is Blake3.Bytes<32>; 16.0 uses a 64-hex-character string.
  Blake3.String
  Layer.[ Primary Secondary Tertiary Quaternary ]
  Subaspect.[ Vision Intent Knowledge Operation Trial Compensation ]
  ; Define the component types once. Source refers to these declarations;
  ; inlining Path.String inside Source would redeclare Path globally.
  Repository.String
  Hash.Blake3
  Path.String
  Reason.String
  Source.{ Repository Hash Path }
  Key.{ Subaspect Topic }
  Said.{ Context.String Verbatim.String }
  Request.[ Order.String
            Question.String
            Psyche.Said
            Psyches.Vector<Said>
            Result.String
            Notice.String ]
  ; A logical delivery keeps one identity across queue retries and native
  ; submission; the id names the living's request, not a delivery attempt.
  LogicalDeliveryId.String
  ; The selected request kind and routing policy are common to every
  ; consumer of Flow messages.
  Aspect.[ Psyche Mind Field ]
  Address.{ Aspect Topic Layer }
  Recipient.[ Address Up ]
  ; Who a queued request is from: the Address Flow resolved for its sender
  ; (the Lock's Sender of a Deliver, the thread's metaflow of a send-tool
  ; call), Unknown for a request queued before Flow kept senders, or Flow
  ; for one Flow raised itself (a landing's orders, a compaction's
  ; investigation).
  SentBy.[ Sender Unknown Flow ]
  ; The durable queue entry is the identity-bearing logical request.
  QueueEntry.{ LogicalDeliveryId SentBy Delivery Message }
  ; What the native surface receives after selection: identity and origin
  ; remain observable, but policy and delivery-attempt metadata do not.
  NativeInput.{ LogicalDeliveryId SentBy Message }
  ; A metaflow is Awake as its current flow or Asleep: a topic never dies,
  ; it goes idle, its flows turned off.
  Metaflow.{ Address
             State.[ Awake.FlowId Asleep ]
             Past.Vector<FlowId>
             Queue.Vector<QueueEntry> }
  Lock.{ Sender Address Until.Integer }
  Process.{ Pid.Integer Started.Integer }
  Sender.Address
  OrdinarySocketPath.String
  MetaSocketPath.String
  StorePath.String
  ; The context repository whose main commits are landings, and the
  ; executable that deploys a landed commit to the modules flows load.
  ContextRepository.String
  DeployBinary.String
  LandingWatch.{ ContextRepository DeployBinary }
  Start.{ OrdinarySocketPath MetaSocketPath StorePath Option<LandingWatch> }
  ; Startup refusal is distinct from the ordinary/meta socket Refusal.Store.String.
  StoreRefusal.{ Path Reason }
  StartRefusal.[ Store.StoreRefusal ]
  SourceRoot.String
  ClientPath.String
  Home.String
  ControlSocketPath.String
  ModelName.String
  CodexEndpoint.{ ClientPath Home ControlSocketPath Vector<ModelName> }
  StableCodex.CodexEndpoint
  NextCodex.CodexEndpoint
  HarnessKind.[ Codex Claude ]
  KeyName.String
  CommandSigil.String
  InterruptKeys.Vector<KeyName>
  SubmitKeys.Vector<KeyName>
  HarnessProfile.{ HarnessKind Vector<CommandSigil> InterruptKeys SubmitKeys }
  HarnessProfiles.Vector<HarnessProfile>
  MetaAspects.Vector<Aspect>
  MessageNexusPath.String
  MessageNexusBinary.String
  Nexus.{ SourceRoot
          StableCodex
          NextCodex
          HarnessProfiles
          MetaAspects
          MessageNexusPath
          MessageNexusBinary
          Lease.Integer } ] ; Lease seconds; 60 before any Nexus payload.
