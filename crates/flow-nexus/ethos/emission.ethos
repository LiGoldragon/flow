; What Flow sends into the world. Each emission is one external call, and
; its outcome is what the translator observed of it: the n-th outcome is
; the n-th emission's. A command line is a type: a variant per subcommand,
; a field per argument, and a String only where a person writes freely or
; the world answers in free text. The translator, src/emission.rs, is the
; one place that holds the words.

Emission
[ signal_flow:[ HerdrSessionName HerdrAgentName HerdrWorkspaceId HerdrPaneId
                HarnessKind LaunchRequestId NativeSessionId Effort FlowId ]
  flow_ethos:[ KeyName ModelName ]
  :flow_nexus:generated:starter:LeanStart
  flow_nexus:[ CurriculumQuery CurriculumOutcome ] ]
[ ; Herdr's command line: one `herdr` process.
  Herdr.HerdrCommand
  ; One query to the Curriculum Nexus, on a connection of its own.
  Curriculum.CurriculumQuery
  ; The flow-id helper's claim of a Flow ID for a native session.
  FlowIdentity.FlowIdentityClaim
  ; One `git` process in the handover archive's work tree, bounded by the
  ; publication's deadline.
  Git.GitCommand
  ; One request line on a Herdr session's socket, one reply line back.
  HerdrSocket.HerdrSocketCall ]
[ ; What the process printed, and whether it ran and succeeded.
  Herdr.ProcessReply
  ; Curriculum's answer, or why none was read.
  Curriculum.CurriculumExchange
  ; What the helper printed: the Flow ID it claimed, or its refusal.
  FlowIdentity.ProcessReply
  ; What Git printed, or that the deadline passed first.
  Git.ProcessReply
  ; Herdr's reply, its refusal, or why none was read.
  HerdrSocket.HerdrSocketReply ]
[ HerdrCommand.[ ListSessions
                 InSession.{ HerdrSessionName HerdrSessionCommand } ]
  ; A command addressed to one Herdr session.
  HerdrSessionCommand.[ Snapshot
                        ClosePane.HerdrPaneId
                        GetPane.HerdrPaneId
                        ReadPaneProcesses.HerdrPaneId
                        RunInPane.{ HerdrPaneId ShellLine }
                        WaitForPaneOutput.{ HerdrPaneId OutputMatch.String OutputSource LineCount Milliseconds }
                        RenamePane.{ HerdrPaneId Label }
                        ReportPaneMetadata.{ HerdrPaneId MetadataSource DisplayAgent.String }
                        SendKeys.{ HerdrPaneId Vector<KeyName> }
                        CreateWorkspace.{ WorkingDirectory.String LaunchRequestId Focus.[ Focused Unfocused ] }
                        RenameWorkspace.{ HerdrWorkspaceId Label }
                        GetWorkspace.HerdrWorkspaceId
                        StartAgent.{ HerdrAgentName HarnessKind HerdrPaneId Milliseconds Option<CodexExecutable> HarnessCommandLine }
                        WaitForAgent.{ AgentTarget AgentWait }
                        GetAgent.AgentTarget
                        ReadAgent.{ HerdrPaneId OutputSource LineCount ScreenFormat.[ Ansi ] }
                        PromptAgent.{ HerdrPaneId PromptText.String Option<AgentWait> } ]
  ; The shell line typed into a pane before its harness runs.
  ShellLine.[ PrepareClaudeEnvironment.ClaudeEnvironment ]
  ; Claude's environment: the Flow ID Reserve gave the launch, if any, the
  ; parts its lean start leaves out by environment, and the marker the line
  ; prints once it has run.
  ClaudeEnvironment.{ Option<FlowId> LeanStart ReadinessMarker.String }
  ; Which of a pane's output a read or a wait looks at.
  OutputSource.[ Visible RecentUnwrapped ]
  LineCount.Integer
  Milliseconds.Integer
  Label.String
  ; Who reports a pane's metadata: Flow itself.
  MetadataSource.[ Flow ]
  ; An agent is named by its pane, or by the agent name Flow gave it.
  AgentTarget.[ Pane.HerdrPaneId Agent.HerdrAgentName ]
  AgentStatus.[ Working Idle Done Blocked ]
  ; Wait until the agent shows any of these states, or the time passes.
  AgentWait.{ Vector<AgentStatus> Milliseconds }
  CodexExecutable.String
  ; The harness's own command line, as Herdr types it into the pane after
  ; the program.
  HarnessCommandLine.[ Claude.ClaudeCommandLine Codex.CodexCommandLine ]
  ; Claude: its settings document, the title it is named and
  ; remote-controlled by, the file its system prompt is read from, the
  ; session it starts or resumes, its model and effort, the parts it starts
  ; without, and the configured arguments.
  ClaudeCommandLine.{ ClaudeSettings.String SessionTitle.String SystemPromptFile.String ClaudeSessionStart ModelName Effort LeanStart ConfiguredHarnessArguments }
  ClaudeSessionStart.[ Unchosen Chosen.NativeSessionId Resumed.NativeSessionId ]
  ; Codex: the app-server socket it attaches to, its model and effort, the
  ; terminal title it shows, the parts it starts without, the configured
  ; arguments, and the opened thread it resumes.
  CodexCommandLine.{ CodexSocket.String ModelName Effort CodexTitle.[ ThreadTitle ] LeanStart ConfiguredHarnessArguments Option<NativeSessionId> }
  ; The arguments the configuration adds, as a person wrote them.
  ConfiguredHarnessArguments.Vector<String>
  Printout.{ Stdout.String Stderr.String }
  ; Unstarted: the process could not be run. Unreadable: it succeeded but
  ; printed what is not UTF-8 text. Cancelled: the observation it served
  ; was cancelled while it ran, and the process was ended. TimedOut: its
  ; deadline passed first, and the process was ended.
  ProcessReply.[ Unstarted.String Succeeded.Printout Failed.Printout Unreadable.String Cancelled TimedOut ]
  ; Unexchanged: the socket could not be reached, or the query written or
  ; the answer read; the String is the transport's own account.
  CurriculumExchange.[ Answered.CurriculumOutcome Unexchanged.String ]
  ; The harness whose session is claimed, the flows directory the claim
  ; is written under, and the native session it is claimed for.
  FlowIdentityClaim.{ HarnessKind FlowsRoot.String NativeSessionId }
  ; The Git commands the handover archive runs, each on a path relative to
  ; the archive's work tree.
  GitCommand.[ ShowsWorkTree
               ResolveRevision.GitRevision
               ShowBlob.GitBlob
               ListTracked.ArchivePath
               ShortStatus.ArchivePath
               Add.ArchivePath
               CommitOnly.ArchivePath ]
  GitRevision.[ Head ArchivedAt.{ GitCommit ArchivePath } ]
  GitCommit.String
  GitBlob.String
  ArchivePath.String
  ; A request on the socket of the session it names.
  HerdrSocketCall.{ HerdrSessionName HerdrSocketRequest }
  ; Prompt the agent with the text, for the launch whose part it is.
  HerdrSocketRequest.[ PromptAgentByName.{ LaunchRequestId HerdrAgentName PromptText } ]
  ; Answered: Herdr's reply line, which carries a result. Refused: the error
  ; Herdr answered with. Unexchanged: the socket was not found or reached,
  ; or the request was too long or not written, or the reply not read.
  HerdrSocketReply.[ Answered.String Refused.String Unexchanged.String ] ]
