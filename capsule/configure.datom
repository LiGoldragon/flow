; The capsule's configuration, one Configure datom per line, applied in order
; over the capsule's meta socket. @SOURCE_ROOT@ and @CAPSULE_RUNTIME@ are
; filled by flow-capsule with its own source root and runtime directory;
; @CURRICULUM_SOCKET@ is the socket of the capsule's own Curriculum Nexus.
; The stable Codex endpoint is the capsule's own app-server, serving
; @CODEX_MODEL@ for { Mind test Terra }; the next endpoint names no
; models. Message names no running executable.
Configure.Nexus.{ @SOURCE_ROOT@ { @CODEX_CLIENT@ @CODEX_HOME@ @CODEX_SOCKET@ [ @CODEX_MODEL@ ] } { @CAPSULE_RUNTIME@/no-codex-client @CAPSULE_RUNTIME@/codex-next @CAPSULE_RUNTIME@/codex-next.sock [] } [ { Claude [ / «!» # ] [ esc esc ] [ enter ] } { Codex [ / «!» ] [ esc ] [] } ] [ Psyche ] @CAPSULE_RUNTIME@/message.sock @CAPSULE_RUNTIME@/no-message-nexus @CURRICULUM_SOCKET@ 60 }
Configure.Models.[ { Fable claude-haiku-5-5 } { Opus claude-haiku-5-5 } { Sonnet claude-haiku-5-5 } { Haiku claude-haiku-5-5 } { Terra @CODEX_MODEL@ } ]
Configure.Thresholds.[ { claude-haiku-5-5 200000 20 } { @CODEX_MODEL@ 200000 20 } ]
Configure.DefaultMinutes.30
Configure.LeaveOuts.[ { { Psyche test Opus } Claude [ ClaudeAiConnectors ExplorePlanAgents WorkflowTool SkillTool BundledSkills ScheduleWakeupTool ReportFindingsTool ListAgentsTool CronTools DeferredTools ClaudeMd GitInstructions ] } { { Psyche test Sonnet } Claude [ ClaudeAiConnectors ExplorePlanAgents WorkflowTool SkillTool BundledSkills ScheduleWakeupTool ReportFindingsTool ListAgentsTool CronTools DeferredTools ClaudeMd GitInstructions ] } { { Psyche test Haiku } Claude [ ClaudeAiConnectors ExplorePlanAgents WorkflowTool SkillTool BundledSkills ScheduleWakeupTool ReportFindingsTool ListAgentsTool CronTools DeferredTools ClaudeMd GitInstructions ] } { { Mind test Terra } Codex [ CodexAgentsMd CodexSkillListing CodexCollaborationMode CodexEnvironmentContext CodexPermissions CodexDeveloperInstructions ] } ]
Configure.Metaflows.[ { { Psyche test Opus } None [ spirit:core intent:models ] [] Simplified Explicit.[] Maintained «» [] } { { Psyche test Sonnet } None [ spirit:core intent:models ] [] Regular Default OnDemand «» [] } { { Psyche test Haiku } None [ spirit:core intent:models ] [] Simplified Explicit.[] OnDemand «» [] } { { Mind test Terra } None [ spirit:core intent:models ] [] Simplified Explicit.[] OnDemand «» [] } ]
