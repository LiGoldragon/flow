[Unit]
Description=Flow Nexus
# Codex starts need the app-server control socket, but the Nexus itself
# starts and serves without it.
Wants=codex-remote-control.service
After=codex-remote-control.service

[Service]
Type=simple
# One unheaded Start argument names the ordinary socket, the meta socket
# and the store, in that order; durable settings live in that store and
# change only over the meta socket. PATH only locates the herdr, codex and
# Codex flow client executables.
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/flow-nexus "{ %t/flow/flow.sock %t/flow/flow-meta.sock %h/.local/state/flow-production/flow.sema }"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
